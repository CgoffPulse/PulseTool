{
  "name": "pulse-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse agency tools ecosystem (monorepo). Each tool is an independent app under apps/*; cross-tool code lives in packages/*.",
  "scripts": {
    "dev:social": "pnpm --filter @pulse/social dev",
    "dev:dev": "pnpm --filter @pulse/dev dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @pulse/db migrate",
    "check:migrations": "pnpm --filter @pulse/db check"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.0.0"
}
