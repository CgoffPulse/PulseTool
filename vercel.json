{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @pulse/social build",
  "outputDirectory": "apps/social/.next",
  "crons": [
    {
      "path": "/api/cron/regenerate-notifications",
      "schedule": "0 13 * * *"
    }
  ]
}
