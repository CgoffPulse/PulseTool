# Supabase (shared with the social tool — same project, dev hub uses the `dev` schema)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# For pnpm migrate (server-side only)
SUPABASE_DB_PASSWORD=YOUR-DB-PASSWORD

# GitHub monitoring — personal access token with repo:read scope
GITHUB_TOKEN=ghp_YOUR_PAT

# Vercel monitoring — token from https://vercel.com/account/tokens
VERCEL_TOKEN=YOUR-VERCEL-TOKEN
VERCEL_TEAM_ID=

# Filesystem monitoring — root directory holding your code projects
DEV_PROJECTS_ROOT=/Users/christian/Developer
