PG_URL=postgresql://...
CRON_SECRET=any-random-string

# Voice gateway — analytics is a thin client of the voice LLM gateway
VOICE_GATEWAY_URL=https://pulse-voice.vercel.app
VOICE_GATEWAY_TOKEN=svc_...

# Meta Graph API (covers Instagram Business + Facebook Page metrics)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://pulse-analytics.vercel.app/api/integrations/meta/callback

# Google Analytics 4 (service account JSON, base64-encoded)
GA4_SERVICE_ACCOUNT_B64=

# Optional public URLs for cross-tool links
NEXT_PUBLIC_SOCIAL_URL=https://pulse-tool-mauve.vercel.app
NEXT_PUBLIC_ANALYTICS_URL=https://pulse-analytics.vercel.app
