# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side only (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Voice gateway (Pulse @pulse/voice — central path to Anthropic).
# Without these the AI surfaces (caption helper, shoot brief, month
# drafter) fall back to documented stubs and the page still renders.
# Mint a token at https://pulse-voice-rho.vercel.app/settings/service-tokens.
VOICE_GATEWAY_URL=https://pulse-voice-rho.vercel.app
VOICE_GATEWAY_TOKEN=YOUR-VOICE-SERVICE-TOKEN
