# Direct Postgres for the voice gateway. Same Supabase project as the rest of
# the suite; voice writes to the `voice` schema and reads `clients` from public.
PG_URL=postgresql://postgres.<project>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Anthropic Claude API key. If missing, the gateway returns deterministic stub
# responses so the entire UI is still navigable.
ANTHROPIC_API_KEY=sk-ant-...

# Bootstrap token. Other Pulse apps may pass this exact value as
# `Authorization: Bearer <VOICE_GATEWAY_INTERNAL_TOKEN>` until a real
# service token is issued via /settings/service-tokens.
VOICE_GATEWAY_INTERNAL_TOKEN=any-random-string

# Public URL of the social tool — used by sister-tool footer links.
NEXT_PUBLIC_SOCIAL_URL=https://pulse-tool-mauve.vercel.app
