# Direct Postgres for the CRM. Same Supabase project as the social + dev tools;
# the CRM only writes to the `crm` schema and reads `public.*` for promote-to-client.
PG_URL=postgresql://postgres.<project>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Cron auth — Vercel cron sends `Authorization: Bearer <CRON_SECRET>` automatically.
CRON_SECRET=any-random-string

# Public URL of this app — used to build link_urls in cross-tool notifications
# so clicking a stalled-lead bell from the social tool routes back here.
NEXT_PUBLIC_CRM_URL=https://pulse-crm.vercel.app

# Public URL of the social tool — used by the "Promote to client" button to
# direct you to the new client's planning page.
NEXT_PUBLIC_SOCIAL_URL=https://pulse-tool-mauve.vercel.app
